# ==============================================================================
# EVIDENCECHAIN VERSION CONTROL EXCLUSIONS (.gitignore)
# Strict security rules prohibiting binary bloat, credentials, and databases
# ==============================================================================

# Node dependencies and compilation builds
/node_modules/
/frontend/node_modules/
/dist/
/frontend/dist/
/bundle/

# Hardhat & Foundry compilation artifacts
/artifacts/
/cache/
/types/
/coverage/
/.gas-snapshot/
/snapshots/
.anvil*
*.state.json
state.json

# Environment configuration & credentials
.env
.env.*
!.env.example
*.pem
*.key
DEMO_CREDENTIALS.md

# macOS & editor temp files
.DS_Store
.Rhistory
*.swp
*.swo
*~
.idea/
.vscode/

# Python runtime and virtual environments
/backend/venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Databases & local state (Strictly prohibited from version control)
*.db
*.sqlite*
/backend/*.db
/backend/database/*.db
/demo_data/

# Uploaded evidence and local assets
/backend/uploads/
/uploads/

# Screenshots, review packages, and binary archives
/screenshots/
*.tar.gz
*.zip

# Runtime logs, process identifiers, and local session caches
*.log
*.pid
/backend/cookies.txt
/backend/test_*.txt
/test_evidence_*.txt
/backups/
