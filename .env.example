# ==============================================================================
# EvidenceChain Environment Configuration Template (.env.example)
# DO NOT COMMIT REAL PRODUCTION SECRETS TO SOURCE CONTROL
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & SERVER ENVIRONMENT
# ------------------------------------------------------------------------------
# Set to 'development' for local evaluation, or 'production' for live deployment.
# In 'development', dynamic MFA codes are printed to the Flask terminal console.
# In 'production', console OTP logging is disabled and secure SMTP dispatch is enforced.
FLASK_ENV=development
ENVIRONMENT=development
FLASK_APP=backend/app.py
PORT=5001
HOST=127.0.0.1

# ------------------------------------------------------------------------------
# 2. SESSION SECURITY & CRYPTOGRAPHIC KEYS
# ------------------------------------------------------------------------------
# Cryptographically secure random secret key used for signing session cookies.
# Generate in production using: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=evidencechain-change-this-in-production-random-secret-key-31337

# Session cookie duration in hours (default: 8 hours)
SESSION_LIFETIME_HOURS=8

# Cookie security settings (automatically set to True when FLASK_ENV=production)
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax

# ------------------------------------------------------------------------------
# 3. BLOCKCHAIN & SMART CONTRACT INTEGRATION
# ------------------------------------------------------------------------------
# Local Hardhat Ethereum RPC node endpoint
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337

# Deployed EvidenceChain.sol contract address
CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# Head of Department (HOD) designated deployer account public address
HOD_WALLET_ADDRESS=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266

# ------------------------------------------------------------------------------
# 4. MULTI-FACTOR AUTHENTICATION (MFA) & EMAIL DISPATCH
# ------------------------------------------------------------------------------
# Note: For local academic and demonstration testing, SMTP is optional.
# When SMTP is unconfigured, OTPs are safely output to the Flask terminal log.
SMTP_ENABLED=false
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=your_smtp_username_here
SMTP_PASSWORD=your_smtp_password_here
SMTP_SENDER=evidencechain-auth@forensics.example.com
SMTP_USE_TLS=true

# MFA Challenge Parameters
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=3

# ------------------------------------------------------------------------------
# 5. DEMONSTRATION & TESTING CONFIGURATION
# ------------------------------------------------------------------------------
# Explicit password required when seeding synthetic demonstration personas.
# Fails safely if unconfigured (no hardcoded fallback permitted).
DEMO_USER_PASSWORD=your_secure_demo_password_here
