# ============================================================
# EvidenceChain Production & Development Configuration Template
# ============================================================
# Copy this file to '.env' and configure according to your deployment tier.
# NEVER commit production '.env' files or secret keys to version control.

# ------------------------------------------------------------
# 1. CORE APPLICATION RUNTIME
# ------------------------------------------------------------
# Options: 'production' | 'development' | 'testing'
# In production:
# - Disables debug stack traces
# - Disables local terminal OTP logging (dispatches via SMTP/SMS)
# - Enforces secure session cookies (HTTPS only)
# - Hard-disables developer demo profile switching
FLASK_ENV=production
ENVIRONMENT=production

# High-entropy random cryptographic key used to sign server-side sessions.
# Generate via: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=generate-a-cryptographically-secure-64-character-hex-key-here

# ------------------------------------------------------------
# 2. LOCAL DEMONSTRATION & DEV GATES (MUST BE FALSE IN PROD)
# ------------------------------------------------------------
# Controls whether /api/auth/demo-switch endpoint is active.
# Triple-gated: requires this flag, FLASK_ENV=development, and loopback IP.
ALLOW_DEV_DEMO_SWITCH=false
ALLOW_DEMO_SWITCH=false

# Controls whether diagnostic development tools (/api/diagnostics/dev-tools) are active.
ALLOW_DEV_DIAGNOSTICS=false

# In demonstration mode, enables public demo login features:
PUBLIC_DEMO_MODE=false

# Default password used when seeding synthetic demonstration personas:
DEMO_USER_PASSWORD=EvidenceChain@Demo2026!

# ------------------------------------------------------------
# 3. DATABASE & STORAGE CONFIGURATION
# ------------------------------------------------------------
# Relative or absolute path to SQLite database register
DATABASE_PATH=evidencechain.db

# Directory where evidence payloads are stored with restricted POSIX permissions
UPLOAD_FOLDER=uploads

# ------------------------------------------------------------
# 4. BLOCKCHAIN CONSENSUS & SMART CONTRACT INTEGRATION
# ------------------------------------------------------------
# Ethereum/EVM JSON-RPC consensus endpoint
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545

# EVM Chain ID (31337 for local Anvil/Hardhat; 1 for Ethereum Mainnet)
CHAIN_ID=31337

# Deployed EvidenceChain Solidity smart contract address
CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# Timeout in seconds for Web3 RPC calls
BLOCKCHAIN_TIMEOUT_SECONDS=10

# ------------------------------------------------------------
# 5. SESSION & SECURITY HEADERS
# ------------------------------------------------------------
# Enforce HTTPS-only transmission for session cookies (True in production)
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax
PERMANENT_SESSION_LIFETIME_HOURS=8
